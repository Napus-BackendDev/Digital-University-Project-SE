      "type": "text",
      "x": 1495,
      "y": 4340,
      "width": 1310,
      "height": 25,
      "text": "Role 2: Staff / Teacher (อาจารย์ / เจ้าหน้าที่)",
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#2563eb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
