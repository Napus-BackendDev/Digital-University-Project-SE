      "x": 75,
      "y": 3720,
      "width": 1310,
      "height": 30,
      "text": "F-4: Analytics & Multi-Format Data Export",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#d97706",
      "backgroundColor": "transparent",
