    {
      "id": "s8_ui_txt_64",
      "type": "text",
      "x": 4550,
      "y": 1389,
      "width": 460,
      "height": 20,
      "text": "A. Vue.js Frontend Model (Data / Props / Vuex)",
      "fontSize": 14.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#0369a1",
      "backgroundColor": "transparent",
