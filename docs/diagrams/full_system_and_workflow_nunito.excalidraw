      "type": "text",
      "x": 80,
      "y": 3215,
      "width": 2500,
      "height": 35,
      "text": "SECTION 3: SYSTEM FUNCTIONS (ฟังก์ชันการทำงานหลักของระบบ 6 โมดูล)",
      "fontSize": 26,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#0369a1",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "isDeleted": false,
      "angle": 0
    },
    {
      "id": "text_1792908641034_1003",
      "type": "text",
      "x": 80,
      "y": 3252,
      "width": 3500,
      "height": 25,
      "text": "การจำแนกฟังก์ชันระบบทั้งหมด 100% ตามโครงสร้างซอร์สโค้ด Node/Express Backend และ Vue.js Frontend",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#475569",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "isDeleted": false,
      "angle": 0
