      "x": 1495,
      "y": 3755,
      "width": 1310,
      "height": 20,
      "text": "Source: backend/server/Project/Email & Nodemailer",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
