      "y": 6362,
      "width": 630,
      "height": 25,
      "text": "FR-06: Access Control & Administration",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
