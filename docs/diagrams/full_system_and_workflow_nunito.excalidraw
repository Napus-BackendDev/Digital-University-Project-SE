    {
      "id": "text_1793118970548_5060",
      "type": "text",
      "x": 1480,
      "y": 7162,
      "width": 630,
      "height": 25,
      "text": "NFR-03: Reliability & Availability",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "isDeleted": false,
      "angle": 0
    },
    {
      "id": "text_1793118970548_5061",
      "type": "text",
      "x": 1490,
      "y": 7218,
      "width": 610,
      "height": 250,
      "text": "• NFR-REL-01: Liveness & Readiness Probing (/healthz Endpoint คืนสถานะ 200 OK)\n\n• NFR-REL-02: Global Error Catching Middleware ไม่เปิดเผย Sensitive Stack Trace\n\n• NFR-REL-03: Cloud High-Availability (MongoDB Atlas Replica Set 3 Nodes อัตโนมัติ)\n\n• NFR-REL-04: Graceful Degradation กรณี SMTP ขัดข้องไม่ทำให้การบันทึกคำตอบล้มเหลว",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "isDeleted": false,
      "angle": 0
    },
