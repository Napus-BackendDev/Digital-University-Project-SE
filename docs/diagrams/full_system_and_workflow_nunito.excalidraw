    },
    {
      "id": "s8_ui_txt_65",
      "type": "text",
      "x": 4550,
      "y": 1432,
      "width": 460,
      "height": 475,
      "text": "• Vuex Store: store.state.auth.user\n  (เก็บข้อมูลโปรไฟล์ผู้ใช้ที่ล็อกอิน)\n\n• LocalStorage: \"token\" (JWT Access Token 7 วัน),\n  \"user\" (JSON Profile)\n\n• Component Data: isAuthenticating (Boolean),\n  errorMessage (String)\n\n• Computed: currentLocale (\"th\" | \"en\"),\n  rolePermissions (Array)",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
