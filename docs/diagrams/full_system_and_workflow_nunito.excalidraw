    {
      "id": "text_1793118970548_5050",
      "type": "text",
      "x": 60,
      "y": 7162,
      "width": 630,
      "height": 25,
      "text": "NFR-01: Security & Protection",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "isDeleted": false,
      "angle": 0
    },
    {
      "id": "text_1793118970548_5051",
      "type": "text",
      "x": 70,
      "y": 7218,
      "width": 610,
      "height": 250,
      "text": "• NFR-SEC-01: HTTP Security Headers (XSS Filter, No-Sniff, IE No-Open, Hide X-Powered-By)\n\n• NFR-SEC-02: DDoS & Abuse Protection (Express Rate-Limiting & Block Suspicious IPs)\n\n• NFR-SEC-03: Strict CORS & Origin Policy (จำกัดเฉพาะ Domain สถาบันที่อนุญาต)\n\n• NFR-SEC-04: Secure Payload Limits (จำกัดขนาด Request Body ไม่เกิน 3MB)\n\n• NFR-SEC-05: OAuth Verification & Cryptographic JWT Signed Secret",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "isDeleted": false,
      "angle": 0
    },
    {
      "id": "arrow_1793118970548_5052",
