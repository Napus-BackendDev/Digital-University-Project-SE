    {
      "id": "text_1793118970548_5055",
      "type": "text",
      "x": 770,
      "y": 7162,
      "width": 630,
      "height": 25,
      "text": "NFR-02: Performance & Scalability",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "isDeleted": false,
      "angle": 0
    },
    {
      "id": "text_1793118970548_5056",
      "type": "text",
      "x": 780,
      "y": 7218,
      "width": 610,
      "height": 250,
      "text": "• NFR-PRF-01: Gzip Compression Middleware เพื่อลดขนาดข้อมูลที่ส่งผ่านเครือข่าย\n\n• NFR-PRF-02: MongoDB Aggregation Pipeline สำหรับประมวลผลสถิติจากฐานข้อมูลโดยตรง\n\n• NFR-PRF-03: Persistent Connection Pool จัดการ Pooling ไปยัง MongoDB Atlas\n\n• NFR-PRF-04: Asynchronous Non-blocking I/O สำหรับการกระจายอีเมลและคิวตอบคำถาม",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "isDeleted": false,
      "angle": 0
    },
