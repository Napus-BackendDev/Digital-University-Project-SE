{
  "tags": [
    {
      "name": "Questions",
      "description": "API for Managing Questions within Forms"
    }
  ],
  "paths": {
    "/api/v1/question/exp": {
      "get": {
        "tags": ["Questions"],
        "summary": "Get all questions",
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/api/v1/question/get": {
      "post": {
        "tags": ["Questions"],
        "summary": "Get one question by ID",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/api/v1/question": {
      "post": {
        "tags": ["Questions"],
        "summary": "Create a new question",
        "responses": {
          "201": { "description": "Created" }
        }
      },
      "put": {
        "tags": ["Questions"],
        "summary": "Update an existing question",
        "responses": {
          "200": { "description": "Updated" }
        }
      },
      "delete": {
        "tags": ["Questions"],
        "summary": "Delete a question",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Deleted" }
        }
      }
    }
  }
}
