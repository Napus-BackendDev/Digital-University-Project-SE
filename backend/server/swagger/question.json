{
  "openapi": "3.0.0",
  "info": {
    "title": "Question API",
    "version": "1.0.0",
    "description": "Question endpoints"
  },
  "tags": [{ "name": "Question" }],
  "paths": {
    "/api/v1/question/exp": {
      "get": {
        "tags": ["Question"],
        "summary": "Get a single question by ID",
        "description": "Pass the question _id as a query parameter. Returns the question with its form reference populated.",
        "parameters": [
          {
            "name": "_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "MongoDB ObjectId of the question",
            "example": "64e1f9f32a6d1c0013a1b111"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "apiId": { "type": "integer", "description": "Always send 11 for this endpoint", "example": 11 }
                }
              },
              "example": { "apiId": 11 }
            }
          }
        },
        "responses": {
          "200": { "description": "Question document with populated form reference" },
          "404": { "description": "Question not found" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/question": {
      "get": {
        "tags": ["Question"],
        "summary": "Get all questions",
        "description": "Returns every question in the database. No extra body fields needed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "apiId": { "type": "integer", "description": "Always send 12 for this endpoint", "example": 12 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Array of all question documents" },
          "500": { "description": "Server error" }
        }
      },
      "post": {
        "tags": ["Question"],
        "summary": "Create a new question",
        "description": "Creates a question linked to a form. The question ID is automatically pushed into the parent form's questions array via a post-save hook.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["form", "type"],
                "properties": {
                  "apiId": { "type": "integer", "description": "Always send 13 for this endpoint", "example": 13 },
                  "form": { "type": "string", "description": "ObjectId of the parent form (ref Forms)", "example": "64e1f9f32a6d1c0013a1b234" },
                  "order": { "type": "number", "description": "Display order of the question (default 1)", "example": 1 },
                  "title": {
                    "type": "array",
                    "description": "Multilingual question title — one object per language",
                    "items": {
                      "type": "object",
                      "required": ["key", "value"],
                      "properties": {
                        "key": { "type": "string", "description": "Language code (e.g. en, th)", "example": "en" },
                        "value": { "type": "string", "description": "Question text in that language", "example": "What is your name?" }
                      }
                    }
                  },
                  "description": {
                    "type": "array",
                    "description": "Multilingual helper text shown below the question",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string", "description": "Language code", "example": "en" },
                        "value": { "type": "string", "description": "Helper text", "example": "Enter your full name" }
                      }
                    }
                  },
                  "type": { "type": "string", "description": "ObjectId of Question_Types (e.g. text, multiple-choice, rating, file-upload)", "example": "64e1f9f32a6d1c0013a1d001" },
                  "isRequired": { "type": "boolean", "description": "Whether the question must be answered (default false)", "example": true },
                  "config": {
                    "type": "object",
                    "description": "Type-specific configuration. Include only the fields relevant to the question type.",
                    "properties": {
                      "choices": {
                        "type": "array",
                        "description": "For multiple-choice / checkbox questions — list of selectable options",
                        "items": {
                          "type": "object",
                          "properties": {
                            "key": { "type": "string", "description": "Unique key for this choice", "example": "opt_a" },
                            "lang": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "key": { "type": "string", "example": "en" },
                                  "value": { "type": "string", "example": "Option A" }
                                }
                              }
                            }
                          }
                        }
                      },
                      "allowMultipleSelect": { "type": "boolean", "description": "Allow selecting more than one choice (checkbox mode)", "example": false },
                      "maxRating": { "type": "number", "description": "For rating questions — maximum star/number value", "example": 5 },
                      "maxText": { "type": "number", "description": "For text questions — character limit", "example": 500 },
                      "maxFiles": { "type": "number", "description": "For file-upload questions — max number of files", "example": 3 },
                      "maxFileSize": { "type": "number", "description": "Max file size in bytes", "example": 5242880 },
                      "fileTypes": {
                        "type": "array",
                        "description": "Allowed MIME types for file uploads",
                        "items": { "type": "string" },
                        "example": ["image/png", "image/jpeg", "application/pdf"]
                      },
                      "imageUrl": { "type": "string", "description": "URL of an image displayed with the question", "example": "https://example.com/img/q1.png" }
                    }
                  }
                }
              },
              "example": {
                "apiId": 13,
                "form": "64e1f9f32a6d1c0013a1b234",
                "order": 1,
                "title": [
                  { "key": "en", "value": "What is your name?" },
                  { "key": "th", "value": "ชื่อของคุณคืออะไร?" }
                ],
                "description": [
                  { "key": "en", "value": "Enter your full name" }
                ],
                "type": "64e1f9f32a6d1c0013a1d001",
                "isRequired": true,
                "config": {
                  "maxText": 200
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Question created and auto-linked to the parent form" },
          "400": { "description": "Validation error — form and type are required" },
          "500": { "description": "Server error" }
        }
      },
      "put": {
        "tags": ["Question"],
        "summary": "Update an existing question",
        "description": "Send the question _id plus any fields you want to change. Only supplied fields are updated.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["_id"],
                "properties": {
                  "apiId": { "type": "integer", "description": "Always send 14 for this endpoint", "example": 14 },
                  "_id": { "type": "string", "description": "MongoDB ObjectId of the question to update", "example": "64e1f9f32a6d1c0013a1b111" },
                  "order": { "type": "number", "description": "New display order", "example": 2 },
                  "title": {
                    "type": "array",
                    "description": "Updated multilingual title",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string", "example": "en" },
                        "value": { "type": "string", "example": "What is your full name?" }
                      }
                    }
                  },
                  "description": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string", "example": "en" },
                        "value": { "type": "string", "example": "Updated helper text" }
                      }
                    }
                  },
                  "type": { "type": "string", "description": "New Question_Types ObjectId", "example": "64e1f9f32a6d1c0013a1d002" },
                  "isRequired": { "type": "boolean", "description": "Update required flag", "example": false },
                  "config": {
                    "type": "object",
                    "description": "Updated type-specific config (see POST for full structure)",
                    "properties": {
                      "choices": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "key": { "type": "string", "example": "opt_a" },
                            "lang": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "key": { "type": "string", "example": "en" },
                                  "value": { "type": "string", "example": "Choice A" }
                                }
                              }
                            }
                          }
                        }
                      },
                      "allowMultipleSelect": { "type": "boolean", "example": true },
                      "maxRating": { "type": "number", "example": 10 },
                      "maxText": { "type": "number", "example": 1000 }
                    }
                  }
                }
              },
              "example": {
                "apiId": 14,
                "_id": "64e1f9f32a6d1c0013a1b111",
                "title": [
                  { "key": "en", "value": "What is your full name?" },
                  { "key": "th", "value": "ชื่อเต็มของคุณคืออะไร?" }
                ],
                "isRequired": false,
                "config": {
                  "maxText": 1000
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Question updated successfully" },
          "404": { "description": "Question not found" },
          "500": { "description": "Server error" }
        }
      },
      "delete": {
        "tags": ["Question"],
        "summary": "Delete a question by its ID",
        "description": "Permanently removes the question. A pre-deleteMany hook automatically removes its ID from the parent form's questions array.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "apiId": { "type": "integer", "description": "Always send 15 for this endpoint", "example": 15 },
                  "_id": { "type": "string", "description": "MongoDB ObjectId of the question to delete", "example": "64e1f9f32a6d1c0013a1b111" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Question deleted and removed from parent form" },
          "500": { "description": "Server error" }
        }
      }
    }
  }
}
