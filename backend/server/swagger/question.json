{
  "openapi": "3.0.0",
  "info": {
    "title": "Question API",
    "version": "1.0.0"
  },
  "tags": [{ "name": "Question" }],
  "paths": {
    "/question/exp": {
      "get": {
        "tags": ["Question"],
        "summary": "Get all questions (apiId: 12)",
        "responses": {
          "200": {
            "description": "Array of question documents",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "type": "array", "items": { "$ref": "#/components/schemas/Question" } }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/question/get": {
      "post": {
        "tags": ["Question"],
        "summary": "Get a single question by ID (apiId: 11)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["_id"],
                "properties": {
                  "apiId": { "type": "integer", "example": 11 },
                  "_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Question document",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/Question" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/question": {
      "post": {
        "tags": ["Question"],
        "summary": "Create question (apiId: 13)",
        "description": "Supports multipart/form-data for image",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "apiId": { "type": "integer", "example": 13 },
                  "image": { "type": "string", "format": "binary" },
                  "form": { "type": "string" },
                  "type": { "type": "string" },
                  "title": { "type": "string", "description": "JSON string" }
                }
              }
            },
            "application/json": {
              "schema": {
                 "type": "object",
                 "required": ["apiId", "form", "type"],
                 "properties": {
                   "apiId": { "type": "integer", "example": 13 },
                   "form": { "type": "string" },
                   "type": { "type": "string" },
                   "title": { "type": "array", "items": { "type": "object" } }
                 }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Question"],
        "summary": "Update question (apiId: 14)",
        "requestBody": {
           "required": true,
           "content": {
             "application/json": {
               "schema": {
                 "type": "object",
                 "required": ["apiId", "_id"],
                 "properties": {
                   "apiId": { "type": "integer", "example": 14 },
                   "_id": { "type": "string" },
                   "title": { "type": "array", "items": { "type": "object" } }
                 }
               }
             }
           }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Question"],
        "summary": "Delete question (apiId: 15)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["apiId", "_id"],
                "properties": {
                  "apiId": { "type": "integer", "example": 15 },
                  "_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Question": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "form": { "type": "string" },
          "type": { "type": "string" },
          "title": { "type": "array", "items": { "type": "object" } },
          "isRequired": { "type": "boolean" },
          "config": { "type": "object" }
        }
      }
    }
  }
}
