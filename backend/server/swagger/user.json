{
  "tags": [
    {
      "name": "Users",
      "description": "API for Managing System Users"
    },
    {
      "name": "Roles",
      "description": "API for Managing User Roles"
    }
  ],
  "paths": {
    "/api/v1/user/exp": {
      "get": {
        "tags": ["Users"],
        "summary": "Get all users",
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/api/v1/user/get": {
      "post": {
        "tags": ["Users"],
        "summary": "Get user by ID",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/api/v1/user": {
      "post": {
        "tags": ["Users"],
        "summary": "Create user",
        "responses": { "201": { "description": "Created" } }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update user",
        "responses": { "200": { "description": "Updated" } }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete user",
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/api/v1/user/role/exp": {
      "get": {
        "tags": ["Roles"],
        "summary": "Get all roles",
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/api/v1/user/role/get": {
      "post": {
        "tags": ["Roles"],
        "summary": "Get role by ID",
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/api/v1/user/role": {
      "post": {
        "tags": ["Roles"],
        "summary": "Create role",
        "responses": { "201": { "description": "Created" } }
      },
      "put": {
        "tags": ["Roles"],
        "summary": "Update role",
        "responses": { "200": { "description": "Updated" } }
      },
      "delete": {
        "tags": ["Roles"],
        "summary": "Delete role",
        "responses": { "200": { "description": "Deleted" } }
      }
    }
  }
}
