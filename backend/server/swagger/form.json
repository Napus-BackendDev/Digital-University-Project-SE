{
  "tags": [
    {
      "name": "Forms",
      "description": "API for Managing Forms"
    }
  ],
  "paths": {
    "/api/v1/form/exp": {
      "get": {
        "tags": ["Forms"],
        "summary": "Get all forms",
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/api/v1/form/get": {
      "post": {
        "tags": ["Forms"],
        "summary": "Get one form by ID",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": { "type": "string", "example": "651a2b3c4d5e6f7a8b9c0d1e" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/api/v1/form": {
      "post": {
        "tags": ["Forms"],
        "summary": "Create a new form",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "array", "items": { "type": "object" } },
                  "creator": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      },
      "put": {
        "tags": ["Forms"],
        "summary": "Update an existing form",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": { "type": "string" },
                  "title": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated" }
        }
      },
      "delete": {
        "tags": ["Forms"],
        "summary": "Delete a form",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Deleted" }
        }
      }
    }
  }
}
