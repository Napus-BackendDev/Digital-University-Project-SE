{
  "tags": [
    {
      "name": "Responses",
      "description": "API for Managing Form Responses"
    }
  ],
  "paths": {
    "/api/v1/response/exp": {
      "get": {
        "tags": ["Responses"],
        "summary": "Get all responses",
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/api/v1/response/getByFormId": {
      "post": {
        "tags": ["Responses"],
        "summary": "Get responses by Form ID",
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/api/v1/response/get": {
      "post": {
        "tags": ["Responses"],
        "summary": "Get one response by ID",
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/api/v1/response": {
      "post": {
        "tags": ["Responses"],
        "summary": "Submit a response",
        "responses": {
          "201": { "description": "Submitted" }
        }
      },
      "put": {
        "tags": ["Responses"],
        "summary": "Update a response",
        "responses": {
          "200": { "description": "Updated" }
        }
      },
      "delete": {
        "tags": ["Responses"],
        "summary": "Delete a response",
        "responses": {
          "200": { "description": "Deleted" }
        }
      }
    },
    "/api/v1/response/download/{form_id}/response/{_id}": {
      "get": {
        "tags": ["Responses"],
        "summary": "Download specific response as JSON",
        "parameters": [
          { "name": "form_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "File downloaded" }
        }
      }
    },
    "/api/v1/response/download/{form_id}": {
      "get": {
        "tags": ["Responses"],
        "summary": "Download all responses for a form",
        "parameters": [
          { "name": "form_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "File downloaded" }
        }
      }
    }
  }
}
