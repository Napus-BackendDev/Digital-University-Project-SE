{
  "openapi": "3.0.0",
  "info": {
    "title": "Response API",
    "version": "1.0.0"
  },
  "tags": [{ "name": "Response" }],
  "paths": {
    "/response/exp": {
      "get": {
        "tags": ["Response"],
        "summary": "Get all responses (apiId: 1)",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "type": "array", "items": { "$ref": "#/components/schemas/Response" } }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/response/get": {
      "post": {
        "tags": ["Response"],
        "summary": "Query responses (apiId: 2)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "apiId": { "type": "integer", "example": 2 },
                  "_id": { "type": "string" },
                  "form_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "oneOf": [{ "$ref": "#/components/schemas/Response" }, { "type": "array", "items": { "$ref": "#/components/schemas/Response" } }] }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/response": {
      "post": {
        "tags": ["Response"],
        "summary": "Submit response (apiId: 3)",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "apiId": { "type": "integer", "example": 3 },
                  "form": { "type": "string" },
                  "responder": { "type": "string" },
                  "answers": { "type": "string" },
                  "files": { "type": "array", "items": { "type": "string", "format": "binary" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "put": {
        "tags": ["Response"],
        "summary": "Update response (apiId: 4)",
        "responses": {
          "200": { "description": "Success", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "delete": {
        "tags": ["Response"],
        "summary": "Delete response (apiId: 5)",
        "responses": {
          "200": { "description": "Success", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Response": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "form": { "type": "object" },
          "responder": { "type": "object" },
          "answers": { "type": "array", "items": { "type": "object" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
