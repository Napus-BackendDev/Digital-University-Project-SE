APP_ENV=production
NODE_ENV=production
PORT=8081
FRONTEND_URL=http://localhost:8080

# Database
MONGODB=mongodb://127.0.0.1:27017/e_questionnaires
TIMEOUT=10000

# Auth & Tokens (set strong secret in production)
JWT_SECRET=change-this-in-production
KEY=change-this-app-key
TOKENLENGTH=32
TOKENEXPIRED=7
TRANSACTIONEXPIRED=1
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional SMTP Mail Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
